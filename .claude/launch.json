{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "backend",
        "start"
      ],
      "port": 3000
    },
    {
      "name": "backend-demo",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "backend/index.js"
      ],
      "env": {
        "DEPANAS_DB": "backend/db/depanas-demo.db"
      },
      "port": 3000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5173
    }
  ]
}
